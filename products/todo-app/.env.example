# Copy this file to .env for local runs. Never commit .env.
# Values in angle brackets are placeholders. Replace them with your own values.

# Required by the API at startup, and by the Prisma CLI for migrate commands.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Optional. The API listens on 4000 when this is unset.
PORT=4000
