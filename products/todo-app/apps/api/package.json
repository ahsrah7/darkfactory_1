{
  "name": "@todo-app/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "generate": "node ../../scripts/prisma-offline.mjs generate",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
